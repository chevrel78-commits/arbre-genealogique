# Copier ce fichier en « .env » et remplacer les valeurs. Ne jamais committer .env.

# Base de développement de l'arbre généalogique (à créer dans hPanel, distincte de celles de Palmares et d'Objectif).
# Utiliser l'IPv4 du serveur MySQL de Hostinger, comme pour Palmares et Objectif.
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@IPV4_DU_SERVEUR:3306/NOM_DE_LA_BASE"
# Base « shadow » : seulement pour `npx prisma migrate dev` (Hostinger interdit à Prisma de créer des bases).
SHADOW_DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@IPV4_DU_SERVEUR:3306/NOM_DE_LA_BASE_SHADOW"

# Adresse du site (sert aux liens envoyés par e-mail).
URL_SITE="http://localhost:3000"

# Envoi des e-mails : laisser SMTP_HOTE vide en développement (les e-mails sont écrits dans le terminal).
# En ligne : la boîte noreply@altea.website (Hostinger). Son mot de passe se saisit seulement dans hPanel.
# SMTP_HOTE="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_UTILISATEUR="noreply@altea.website"
# SMTP_MOT_DE_PASSE=""
# EMAIL_EXPEDITEUR="Arbre généalogique <noreply@altea.website>"

# Dossier des photos et documents (par défaut : stockage/medias, exclu de Git).
# STOCKAGE_MEDIAS=""
